local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local debug_getupvalues = debug.getupvalues or getupvalues
local debug_setupvalue = debug.setupvalue or setupvalue

local function applyMods(tbl)
    if type(tbl) ~= "table" then return end
    tbl.FireRate = 0
    tbl.Auto = true
    tbl.BurstFireEnabled = false
    tbl.DelayBeforeFiring = 0
    tbl.DelayAfterFiring = 0
    tbl.ChargingTime = 0
    tbl.ChargedShotEnabled = false
    tbl.MinigunEnabled = false
    tbl.Spread = 0
    tbl.SpreadRedution = 0
    tbl.CameraShakingEnabled = false
    tbl.LimitedClipEnabled = false
    tbl.AmmoPerClip = 999999
    tbl.MaxClip = 999999
end

local function patchWeapon(tool)
    if not tool or not tool:IsA("Tool") then return end

    -- 1. Modify Setting Module
    local settingModule = tool:FindFirstChild("Setting")
    if settingModule and settingModule:IsA("ModuleScript") then
        local success, config = pcall(require, settingModule)
        if success and type(config) == "table" then
            applyMods(config)
        end
    end

    -- 2. Hook SendInfo OnClientEvent
    local gunServer = tool:FindFirstChild("GunScript_Server")
    local sendInfo = gunServer and gunServer:FindFirstChild("SendInfo")

    if sendInfo and getconnections then
        for _, conn in ipairs(getconnections(sendInfo.OnClientEvent)) do
            local oldFn = conn.Function
            if oldFn then
                if debug_getupvalues then
                    for _, uv in pairs(debug_getupvalues(oldFn)) do
                        if type(uv) == "table" then applyMods(uv) end
                    end
                end

                if hookfunction then
                    hookfunction(oldFn, function(p1, p2, p3)
                        if type(p1) == "table" then applyMods(p1) end
                        return oldFn(p1, p2, p3)
                    end)
                end
            end
        end
    end

    -- 3. Neuter VerifyExploit to prevent anti-cheat kicks
    if getconnections and debug_getupvalues and debug_setupvalue then
        for _, event in ipairs({tool.Equipped, tool.Unequipped}) do
            for _, conn in ipairs(getconnections(event)) do
                if conn.Function then
                    for idx, uv in pairs(debug_getupvalues(conn.Function)) do
                        if type(uv) == "function" then
                            debug_setupvalue(conn.Function, idx, function() end)
                        elseif type(uv) == "table" then
                            applyMods(uv)
                        end
                    end
                end
            end
        end
    end

    print("✅ Successfully patched weapon & bypassed anti-cheat:", tool.Name)
end

local function scanContainer(container)
    if not container then return end
    for _, item in ipairs(container:GetChildren()) do patchWeapon(item) end
    container.ChildAdded:Connect(function(child)
        task.wait(0.1)
        patchWeapon(child)
    end)
end

if LocalPlayer:FindFirstChild("Backpack") then scanContainer(LocalPlayer.Backpack) end
if LocalPlayer.Character then scanContainer(LocalPlayer.Character) end

LocalPlayer.CharacterAdded:Connect(function(char)
    scanContainer(char)
    local backpack = LocalPlayer:WaitForChild("Backpack", 5)
    if backpack then scanContainer(backpack) end
end)
