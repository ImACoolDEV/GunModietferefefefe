--------------------------------------------------------------------------------
-- UNIVERSAL GUNSCRIPT_LOCAL MODIFIER & EXPLOIT BYPASS
--------------------------------------------------------------------------------
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local debug_getupvalues = debug.getupvalues or getupvalues
local debug_setupvalue = debug.setupvalue or setupvalue

-- Apply modified values to target table
local function applyGunMods(tbl)
    if type(tbl) ~= "table" then return end

    -- Firing Mechanics
    tbl.FireRate = 0
    tbl.Auto = true
    tbl.BurstFireEnabled = false
    
    -- Delays & Charge Bypasses
    tbl.DelayBeforeFiring = 0
    tbl.DelayAfterFiring = 0
    tbl.ChargingTime = 0
    tbl.ChargedShotEnabled = false
    tbl.MinigunEnabled = false

    -- Spread & Camera Recoil
    tbl.Spread = 0
    tbl.SpreadRedution = 0
    tbl.CameraShakingEnabled = false

    -- Ammo Limits
    tbl.LimitedClipEnabled = false
    tbl.AmmoPerClip = 999999
    tbl.MaxClip = 999999
end

-- Locates runtime upvalues inside GunScript_Local
local function findRuntimeTable(tool, gunScript)
    if not debug_getupvalues then return nil end

    -- Method 1: Check connections on Equipped/Unequipped
    if getconnections then
        for _, event in ipairs({tool.Equipped, tool.Unequipped}) do
            for _, conn in ipairs(getconnections(event)) do
                if conn.Function then
                    local upvals = debug_getupvalues(conn.Function)
                    for _, uv in pairs(upvals) do
                        if type(uv) == "table" and uv.AmmoPerClip ~= nil then
                            return uv
                        elseif type(uv) == "function" then
                            local subUpvals = debug_getupvalues(uv)
                            for _, subUv in pairs(subUpvals) do
                                if type(subUv) == "table" and subUv.AmmoPerClip ~= nil then
                                    return subUv
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Method 2: Inspect script environment
    if getsenv then
        local success, env = pcall(getsenv, gunScript)
        if success and env then
            for _, fn in pairs(env) do
                if type(fn) == "function" then
                    local upvals = debug_getupvalues(fn)
                    for _, uv in pairs(upvals) do
                        if type(uv) == "table" and uv.AmmoPerClip ~= nil then
                            return uv
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function processGun(tool)
    if not tool or not tool:IsA("Tool") then return end

    local gunScript = tool:FindFirstChild("GunScript_Local")
    local settingModule = tool:FindFirstChild("Setting")

    if not gunScript then return end

    print("🔍 Processing weapon:", tool.Name)

    -- 1. Modify the Setting Module
    local settingTable = nil
    if settingModule and settingModule:IsA("ModuleScript") then
        local success, res = pcall(require, settingModule)
        if success and type(res) == "table" then
            settingTable = res
            applyGunMods(settingTable)
        end
    end

    -- 2. Modify the active server-sent upvalue (v5)
    task.spawn(function()
        local v5Table = nil
        local attempts = 0

        -- Wait briefly until v5 is populated by SendInfo event
        repeat
            task.wait(0.1)
            v5Table = findRuntimeTable(tool, gunScript)
            attempts = attempts + 1
        until v5Table ~= nil or attempts > 30

        if v5Table then
            applyGunMods(v5Table)
            print("✅ Successfully modified runtime stats & bypassed anti-cheat for:", tool.Name)
        else
            warn("⚠️ Could not reach runtime upvalue for:", tool.Name, "(Setting module updated)")
        end
    end)
end

-- Scan containers
local function scanContainer(container)
    if not container then return end
    for _, item in ipairs(container:GetChildren()) do
        processGun(item)
    end
    container.ChildAdded:Connect(function(child)
        task.wait(0.1)
        processGun(child)
    end)
end

-- Initialize listeners
if LocalPlayer:FindFirstChild("Backpack") then
    scanContainer(LocalPlayer.Backpack)
end

if LocalPlayer.Character then
    scanContainer(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    scanContainer(char)
    local backpack = LocalPlayer:WaitForChild("Backpack", 5)
    if backpack then scanContainer(backpack) end
end)
